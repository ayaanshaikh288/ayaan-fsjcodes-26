<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body style="text-align: center; background-color: pink;">
    <h1>Welcome to my Site </h1>
    <br><br>
    <h2>Rehan Shaikh </h2>
    <br>
    <button onclick="background_changer()">Click me to change the background</button>
   
    <script>
        function background_changer(){
            const bodyele=document.querySelector("body");
            let colors=["red","blue","beige","olive","brown","glacier"];
            let randomindex=Math.floor(Math.random()*colors.length);
            bodyele.style.backgroundColor=colors[randomindex];
        }
        setInterval(() => {
            background_changer();
            
        }, 5000);
    </script>
</body>
</html>
